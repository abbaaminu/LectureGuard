<?xml version="1.0" encoding="utf-8"?>
<!-- Launch screen shown while the process starts, before Flutter draws.
     The mark is the same artwork as the launcher icon (see
     tool/generate_app_icons.py and branding/lectureguard_icon.svg). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splash_background" />

    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_logo" />
    </item>
</layer-list>
